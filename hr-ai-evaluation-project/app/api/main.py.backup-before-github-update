def extract_docx_text(file_bytes: bytes) -> str:
    document = Document(io.BytesIO(file_bytes))

    parts = []

    for paragraph in document.paragraphs:
        text = paragraph.text.strip()
        if text:
            parts.append(text)

    for table in document.tables:
        for row in table.rows:
            row_text = " | ".join(
                cell.text.strip()
                for cell in row.cells
                if cell.text.strip()
            )

            if row_text:
                parts.append(row_text)

    return "\n".join(parts)


def normalize_result(result: dict) -> dict:
    """
    Normalize the model output into the exact application schema.
    """

    profile = result.get("candidate_profile", {})

    personal = profile.get("personal_information", {})

    normalized = {
        "candidate_profile": {
            "personal_information": {
                "name": personal.get("name"),
                "email": personal.get("email"),
                "phone": personal.get("phone"),
                "location": personal.get("location"),
            },
            "professional_summary": profile.get(
                "professional_summary"
            ),
            "skills": profile.get("skills", []),
            "work_experience": [],
            "education": [],
            "certifications": [],
            "languages": [],
        }
    }

    # Work experience
    for item in profile.get("work_experience", []):
        responsibilities = item.get("responsibilities", [])

        description = item.get("description")

        if not description and responsibilities:
            description = "\n".join(
                str(value) for value in responsibilities
            )

        normalized["candidate_profile"]["work_experience"].append(
            {
                "job_title": item.get("job_title"),
                "company": item.get("company"),
                "location": item.get("location"),
                "start_date": item.get("start_date"),
                "end_date": item.get("end_date"),
                "description": description,
            }
        )

    # Education
    for item in profile.get("education", []):
        normalized["candidate_profile"]["education"].append(
            {
                "degree": item.get("degree"),
                "field_of_study": item.get("field_of_study"),
                "institution": item.get("institution"),
                "location": item.get("location"),
                "graduation_date": (
                    item.get("graduation_date")
                    or item.get("year")
                ),
            }
        )

    # Certifications
    for item in profile.get("certifications", []):
        if isinstance(item, str):
            normalized["candidate_profile"]["certifications"].append(
                {
                    "name": item,
                    "issuer": None,
                    "date": None,
                }
            )
        else:
            normalized["candidate_profile"]["certifications"].append(
                {
                    "name": item.get("name"),
                    "issuer": item.get("issuer"),
                    "date": item.get("date"),
                }
            )

    # Languages
    for item in profile.get("languages", []):
        if isinstance(item, str):
            normalized["candidate_profile"]["languages"].append(
                {
                    "language": item,
                    "proficiency": None,
                }
            )
        else:
            normalized["candidate_profile"]["languages"].append(
                {
                    "language": item.get("language"),
                    "proficiency": item.get("proficiency"),
                }
            )

    return normalized


